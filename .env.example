# Copy to .env on the VPS. Never commit the real .env file.
ROOT_DOMAIN=tyfino.online
ADMIN_DOMAIN=admin.tyfino.online
API_DOMAIN=api.tyfino.online

POSTGRES_DB=tyfino
POSTGRES_USER=tyfino
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql://tyfino:CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD@db:5432/tyfino

API_PORT=3000
LOG_LEVEL=info
TRUST_PROXY=true
APP_ENV=production
ADMIN_ORIGIN=https://admin.tyfino.online

# Generate with: openssl rand -hex 32
TOKEN_PEPPER=CHANGE_ME_LONG_RANDOM_TOKEN_PEPPER

# Used only to create the first owner account. Remove the password after the first successful startup.
ADMIN_BOOTSTRAP_EMAIL=owner@tyfino.online
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_USE_AT_LEAST_14_CHARACTERS

# RFC 4648 Base32 secret (at least 20 random bytes) provisioned in the owner's authenticator app.
# Example generation on Linux: openssl rand 20 | base32 | tr -d '=\n'
# Generate securely outside the repository and never reuse TOKEN_PEPPER.
ADMIN_OWNER_TOTP_SECRET=CHANGE_ME_BASE32_TOTP_SECRET
