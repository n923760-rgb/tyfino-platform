# Copy to .env on the VPS. Never commit the real .env file.
ROOT_DOMAIN=tyfino.online
ADMIN_DOMAIN=admin.tyfino.online
API_DOMAIN=api.tyfino.online

POSTGRES_DB=tyfino
POSTGRES_USER=tyfino_owner
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_OWNER_PASSWORD
POSTGRES_APP_USER=tyfino_app
POSTGRES_APP_PASSWORD=CHANGE_ME_USE_A_DIFFERENT_LONG_RANDOM_APP_PASSWORD
DATABASE_URL=postgresql://tyfino_app:CHANGE_ME_USE_A_DIFFERENT_LONG_RANDOM_APP_PASSWORD@db:5432/tyfino

API_PORT=3000
LOG_LEVEL=info
TRUST_PROXY=true
APP_ENV=production
ADMIN_ORIGIN=https://admin.tyfino.online

# Production thresholds must be approved from observed traffic and explicitly configured.
GLOBAL_RATE_LIMIT_PER_MINUTE=CHANGE_ME
ADMIN_AUTH_RATE_LIMIT_PER_15_MINUTES=CHANGE_ME
TRIAL_START_RATE_LIMIT_PER_HOUR=CHANGE_ME
ACTIVATION_RATE_LIMIT_PER_15_MINUTES=CHANGE_ME
ENTITLEMENT_REFRESH_RATE_LIMIT_PER_HOUR=CHANGE_ME

# Bounded service work; approve values against production latency before deployment.
HTTP_REQUEST_TIMEOUT_MS=CHANGE_ME
DATABASE_STATEMENT_TIMEOUT_MS=CHANGE_ME

# Generate with: openssl rand -hex 32
TOKEN_PEPPER=CHANGE_ME_LONG_RANDOM_TOKEN_PEPPER

# Used only to create the first owner account. Remove the password after the first successful startup.
ADMIN_BOOTSTRAP_EMAIL=owner@tyfino.online
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_USE_AT_LEAST_14_CHARACTERS

# RFC 4648 Base32 secret (at least 20 random bytes) provisioned in the owner's authenticator app.
# Example generation on Linux: openssl rand 20 | base32 | tr -d '=\n'
# Generate securely outside the repository and never reuse TOKEN_PEPPER.
ADMIN_OWNER_TOTP_SECRET=CHANGE_ME_BASE32_TOTP_SECRET
