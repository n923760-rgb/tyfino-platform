    "Live Gate",
    "Task",
    "Validation",
    "Artifacts",
    "Stop Conditions",
    "Report Path",
    "Success Criteria"
  ],
  "result_required_sections": [
    "Task Identity",
    "Repository Identity",
    "Authority",
    "Scope",
    "Commands Actually Run",
    "Validation Actually Run",
    "Validation Not Run",
    "Findings",
    "Changes",
    "Artifacts",
    "Failure Analysis",
    "Residual Risks",
    "Recommended Next Action"
  ]
