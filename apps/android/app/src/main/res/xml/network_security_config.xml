<?xml version="1.0" encoding="utf-8"?>
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <!-- User-approved HTTP IPTV providers require this base policy; licensing is HTTPS-only below. -->
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration" />
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">tyfino.online</domain>
    </domain-config>
</network-security-config>
